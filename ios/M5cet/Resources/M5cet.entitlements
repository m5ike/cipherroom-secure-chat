<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Capabilities of M5cet (cz.m5cet.app). Automatic signing registers them on the App ID.
  Values with $(…) come from ios/Config/Base.xcconfig (and the git-ignored Signing.xcconfig).
  CallKit needs no entitlement; VoIP pushes (PushKit) use aps-environment + the "voip"
  background mode (Info.plist).
-->
<plist version="1.0">
<dict>
	<!-- APNs. "development" for Xcode builds; an App Store / TestFlight export signs with "production". -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Core NFC: tag sessions (ISO 7816, MIFARE, FeliCa, ISO 15693) and NDEF sessions. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
		<string>NDEF</string>
	</array>

	<!-- Data the notification extension reads (sealed-message keys, lock state) — Platform/Push. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(M5_APP_GROUP)</string>
	</array>

	<!-- The keychain group shared with the notification extension (its first group is its default). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)cz.m5cet.app</string>
	</array>

	<!-- Passkeys of the server this build is for (M5_WEBCREDENTIALS_DOMAIN, ios/README.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(M5_WEBCREDENTIALS_DOMAIN)</string>
	</array>
</dict>
</plist>
