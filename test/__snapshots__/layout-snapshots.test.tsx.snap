exports[`recipients widget layouts > floating, manual, settings 1`] = `"<div aria-label="Recipients" class="recip-widget" data-testid="recip-widget" role="group" style="right: 12px; bottom: 88px; transform-origin: bottom right; width: 260px; opacity: 1; transform: scale(1); font-size: 1rem; background: #123456;"><div class="recip-widget__head" data-testid="recip-drag"><svg aria-hidden="true" class="lucide lucide-grip-horizontal h-4 w-4 opacity-60" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="9" r="1"></circle><circle cx="19" cy="9" r="1"></circle><circle cx="5" cy="9" r="1"></circle><circle cx="12" cy="15" r="1"></circle><circle cx="19" cy="15" r="1"></circle><circle cx="5" cy="15" r="1"></circle></svg><span class="recip-widget__title">"Recipients"</span><button aria-label="Widget settings" class="recip-widget__min" data-testid="recip-config-toggle" title="Widget settings" type="button"><svg aria-hidden="true" class="lucide lucide-settings-2 h-4 w-4" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M14 17H5"></path><path d="M19 7h-9"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg></button><button aria-label="Dock (lock)" class="recip-widget__min" data-testid="recip-lock" title="Dock (lock)" type="button"><svg aria-hidden="true" class="lucide lucide-lock h-4 w-4" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></button><button aria-label="Minimise" class="recip-widget__min" type="button"><svg aria-hidden="true" class="lucide lucide-minus h-4 w-4" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14"></path></svg></button></div><div class="recip-config" data-testid="recip-config"><label class="recip-cfg-row"><span>"Width"</span><span class="flex items-center gap-2"><input max="420" min="180" step="10" type="range" value="260"></input><span class="recip-cfg-val">"260px"</span></span></label><label class="recip-cfg-row"><span>"Opacity"</span><span class="flex items-center gap-2"><input max="1" min="0.3" step="0.05" type="range" value="1"></input><span class="recip-cfg-val">"100%"</span></span></label><label class="recip-cfg-row"><span>"Font"</span><span class="flex items-center gap-2"><input max="1.4" min="0.8" step="0.05" type="range" value="1"></input><span class="recip-cfg-val">"1×"</span></span></label><label class="recip-cfg-row"><span>"Zoom"</span><span class="flex items-center gap-2"><input max="1.4" min="0.7" step="0.05" type="range" value="1"></input><span class="recip-cfg-val">"1×"</span></span></label><label class="recip-cfg-row"><span>"Colour"</span><span class="flex items-center gap-2"><input class="h-6 w-8 rounded border-0 bg-transparent p-0" type="color" value="#123456"></input><button class="text-[10px] underline" type="button">"Default"</button></span></label></div><div class="recip-widget__body"><ul class="recip-list"><li class="recip-row" data-testid="recip-p1"><span aria-hidden="true" class="user-avatar " style="width: 26px; height: 26px; color: hsl(257 70% 42%); font-size: 11px;">"A"</span><span class="recip-name">"Ann"</span><span aria-hidden="true" class="lat-meter lat-good" title="40 ms"><span class="lat-bar on" style="height: 25%;"></span><span class="lat-bar on" style="height: 50%;"></span><span class="lat-bar on" style="height: 75%;"></span><span class="lat-bar on" style="height: 100%;"></span></span><button 