// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`app bar, chat window and composer layouts > app bar 1`] = `"<header class="toolbar relative flex min-h-[3rem] flex-wrap items-center gap-2 border-b border-border bg-card/85 px-3 py-2 backdrop-blur supports-[backdrop-filter]:bg-card/70 sm:px-4"><button aria-label="Room" class="inline-flex items-center gap-2 rounded-2xl px-2 py-1 hover:bg-accent" data-testid="button-brand" type="button"><svg aria-label="M5cet logo" class="text-primary" height="32" role="img" viewBox="0 0 64 64" width="32" xmlns="http://www.w3.org/2000/svg"><defs><lineargradient id="m5-stripe" x1="0" x2="1" y1="0" y2="0"><stop offset="0%" stop-color="#1c5fd6"></stop><stop offset="33%" stop-color="#1c5fd6"></stop><stop offset="33%" stop-color="#4b2bcd"></stop><stop offset="66%" stop-color="#4b2bcd"></stop><stop offset="66%" stop-color="#d61c2f"></stop><stop offset="100%" stop-color="#d61c2f"></stop></lineargradient><lineargradient id="m5-shell" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="currentColor" stop-opacity="0.18"></stop><stop offset="100%" stop-color="currentColor" stop-opacity="0.04"></stop></lineargradient></defs><path d="M32 3 L57 17 L57 47 L32 61 L7 47 L7 17 Z" fill="url(#m5-shell)" stroke-linejoin="round" stroke-width="2.2" stroke="currentColor"></path><path d="M9 41 H55 L52 49 H12 Z" fill="url(#m5-stripe)"></path><path d="M14 38 L23 16 L32 38 L41 16 L50 38" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="3.2" stroke="currentColor"></path><text fill="#ffffff" font-family="system-ui, -apple-system, 'Segoe UI', sans-serif" font-size="8" font-weight="800" letter-spacing="0.5" text-anchor="middle" x="32" y="48">"5"</text></svg><div class="hidden text-left sm:block"><div class="text-sm font-bold leading-tight">"M5cet"</div><div class="text-[11px] leading-tight text-muted-foreground">"Encrypted P2P chat — sharp-tuned workspace."</div></div></button><span class="ml-2 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs transition-colors border-emerald-500/40 bg-emerald-500/10" data-testid="status-connection" title="state: open"><svg aria-hidden="true" class="lucide lucide-wifi h-3.5 w-3.5 text-emerald-500" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M12 20h.01"></path><path d="M2 8.82a15 15 0 0 1 20 0"></path><path d="M5 12.859a10 10 0 0 1 14 0"></path><path d="M8.5 16.429a5 5 0 0 1 7 0"></path></svg><span class="hidden sm:inline">"2 P2P · brno"</span><span class="sm:hidden">"2"</span></span><label class="cx-switcher" data-testid="cx-switcher" title="Connection"><svg aria-hidden="true" class="lucide lucide-plug h-3.5 w-3.5 shrink-0" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M12 22v-5"></path><path d="M15 8V2"></path><path d="M17 8a1 1 0 0 1 1 1v4a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1z"></path><path d="M9 8V2"></path></svg><span class="sr-only">"Connection"</span><select data-testid="cx-switcher-select"><option value="">"—"</option><option value="a">"Team"</option></select></label><i data-slot="signed-in"></i><i data-slot="menu"></i><button aria-label="Fullscreen" class="inline-flex items-center justify-center rounded-2xl hover:bg-accent" data-testid="btn-toolbar-fullscreen" title="Fullscreen" type="button"><svg aria-hidden="true" class="lucide lucide-maximize-2 h-4 w-4" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M15 3h6v6"></path><path d="m21 3-7 7"></path><path d="m3 21 7-7"></path><path d="M9 21H3v-6"></path></svg></button></header>"`;

exports[`app bar, chat window and composer layouts > chat window with messages 1`] = `"<main class="relative flex flex-1 min-h-0 flex-col chat-canvas"><div class="flex flex-1 min-h-0 flex-col"><div class="flex-shrink-0 border-b border-border bg-card/60 px-3 py-2 sm:px-4" data-layout-hide="focus"><div class="flex items-center justify-between gap-3 text-xs"><p class="truncate text-muted-foreground" data-testid="text-notice">"hello"</p><div class="flex items-center gap-2 font-mono text-[11px] text-muted-foreground"><span>"room:brno"</span><span class="hidden sm:inline">"·"</span><span class="hidden sm:inline">"0123456789"</span><button class="ml-1 inline-flex items-center gap-1 rounded-full border border-border bg-background px-2 py-0.5 hover:bg-accent" data-testid="button-disconnect-bar" type="button"><svg aria-hidden="true" class="lucide lucide-log-out h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>"Disconnect"</button><button class="ml-1 inline-flex items-center gap-1 rounded-full border border-border bg-background px-2 py-0.5 hover:bg-accent" type="button"><svg aria-hidden="true" class="lucide lucide-copy h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="14" rx="2" ry="2" width="14" x="8" y="8"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>"Copy"</button></div></div></div><div class="flex-1 overflow-y-auto chat-surface p-3 sm:p-5" data-testid="list-messages"><div class="mx-auto mb-4 grid w-full max-w-4xl grid-cols-1 gap-2 md:grid-cols-2"><i data-t="t1"></i></div><div class="chat-column mx-auto w-full space-y-3"><button class="show-earlier" data-testid="button-show-earlier" type="button">"Show 3"</button><i data-m="m1"></i><i data-m="m2"></i><div></div></div></div><i data-slot="composer"></i></div></main>"`;

exports[`app bar, chat window and composer layouts > composer 1`] = `"<form class="composer border-t border-border bg-card/80 backdrop-blur"><div class="chat-column mx-auto w-full"><div class="composer-reply" data-testid="composer-reply"><button class="composer-reply__jump" type="button"><svg aria-hidden="true" class="lucide lucide-corner-up-left h-3.5 w-3.5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path><path d="M9 14 4 9l5-5"></path></svg><span class="composer-reply__inner"><span class="composer-reply__name">"Reply to Bob"</span><span class="composer-reply__text">"yes"</span></span></button><button aria-label="Close" class="composer-reply__x" type="button">"×"</button></div><div class="mb-2 flex flex-wrap gap-1 rounded-2xl border border-border bg-background p-2" data-testid="picker-emoji"><button class="rounded-xl px-2 py-1 text-lg hover:bg-accent" type="button">"😀"</button><button class="rounded-xl px-2 py-1 text-lg hover:bg-accent" type="button">"👍"</button></div><div class="composer-bar"><div class="composer-actions"><button aria-expanded="true" aria-label="Emoji" class="composer-icon-btn" data-testid="button-emoji" title="Emoji" type="button"><svg aria-hidden="true" class="lucide lucide-face-slightly-smiling lucide-smile h-5 w-5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M15 10V9"></path><path d="M16.472 15a6 6 0 01-8.943 0"></path><path d="M9 10V9"></path><circle cx="12" cy="12" r="10"></circle></svg></button><button aria-label="File" class="composer-icon-btn" data-testid="button-attach-file" disabled="" title="File" type="button"><svg aria-hidden="true" class="lucide lucide-paperclip h-5 w-5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"></path></svg></button><button aria-label="Image" class="composer-icon-btn" data-testid="button-attach-image" disabled="" title="Image" type="button"><svg aria-hidden="true" class="lucide lucide-image h-5 w-5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="18" rx="2" ry="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></button><i data-slot="recorder"></i></div><label class="sr-only" for="message">"Type an encrypted message..."</label><textarea class="composer-input" data-testid="input-message" id="message" placeholder="Write…" rows="1">"draft"</textarea><i data-slot="send"></i></div><div class="composer-foot"><span class="recipient-hint is-private"><svg aria-hidden="true" class="lucide lucide-lock h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>" Ann, Bob"</span><p class="composer-hint">"Up to 512 kB travels inside the message; larger files are sent encrypted in chunks."</p></div><input class="hidden" data-testid="input-file" type="file"></input><input accept="image/*" class="hidden" data-testid="input-image" type="file"></input></div></form>"`;

exports[`app bar, chat window and composer layouts > empty chat window 1`] = `"<main class="relative flex flex-1 min-h-0 flex-col chat-canvas"><div class="flex flex-1 min-h-0 flex-col"><div class="flex-shrink-0 border-b border-border bg-card/60 px-3 py-2 sm:px-4" data-layout-hide="focus"><div class="flex items-center justify-between gap-3 text-xs"><p class="truncate text-muted-foreground" data-testid="text-notice"></p><div class="flex items-center gap-2 font-mono text-[11px] text-muted-foreground"><span>"idle"</span><span class="hidden sm:inline">"·"</span><span class="hidden sm:inline">"0123456789"</span><button class="ml-1 inline-flex items-center gap-1 rounded-full border border-border bg-background px-2 py-0.5 hover:bg-accent" type="button"><svg aria-hidden="true" class="lucide lucide-copy h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="14" rx="2" ry="2" width="14" x="8" y="8"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>"Copied"</button></div></div></div><div class="flex-1 overflow-y-auto chat-surface p-3 sm:p-5" data-testid="list-messages"><div class="flex h-full min-h-[60dvh] items-center justify-center"><div class="max-w-md rounded-3xl border border-border bg-card/90 p-6 text-center shadow-sm"><div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary"><svg aria-hidden="true" class="lucide lucide-lock h-6 w-6" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div><h3 class="text-lg font-semibold">"Title"</h3><p class="mt-2 text-sm text-muted-foreground">"Body"</p><button class="mt-4 inline-flex min-h-10 items-center gap-2 rounded-2xl bg-primary px-4 text-sm font-semibold text-primary-foreground" data-testid="button-open-join" type="button"><svg aria-hidden="true" class="lucide lucide-radio h-4 w-4" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"></path><path d="M19.075 4.933a10 10 0 0 1 0 14.134"></path><path d="M4.925 19.067a10 10 0 0 1 0-14.134"></path><path d="M7.753 16.239a6 6 0 0 1 0-8.478"></path><circle cx="12" cy="12" r="2"></circle></svg>"Connect"</button></div></div></div></div></main>"`;

