 h-4 w-4 opacity-80" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"></path><path d="M19.075 4.933a10 10 0 0 1 0 14.134"></path><path d="M4.925 19.067a10 10 0 0 1 0-14.134"></path><path d="M7.753 16.239a6 6 0 0 1 0-8.478"></path><circle cx="12" cy="12" r="2"></circle></svg><span class="recip-name">"Room · brno"</span><button aria-label="Session information" class="recip-info" type="button"><svg aria-hidden="true" class="lucide lucide-info h-4 w-4" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button><button aria-label="Automatically to the whole room" aria-pressed="false" class="recip-check off" data-testid="recip-auto" type="button"><svg aria-hidden="true" class="lucide lucide-x h-4 w-4" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="recip-actions"><button type="button">"All"</button><button type="button">"None"</button></div></div></div>"`;

exports[`recipients widget layouts > minimised 1`] = `"<button aria-label="Recipients" class="recip-fab" data-testid="recip-fab" style="left: 10px; top: 20px; transform-origin: top left;" title="Recipients" type="button"><svg aria-hidden="true" class="lucide lucide-users h-5 w-5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg><span class="recip-fab__count">"2"</span></button>"`;
