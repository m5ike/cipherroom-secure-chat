exports[`message layouts > in · file 1`] = `"<article class="msg-row flex justify-start" data-testid="message-m1"><div class="msg-bubble msg-bubble--theirs"><div class="msg-bubble__head"><b>"badge"</b><span class="msg-bubble__time">"10:42"</span></div><div><p class="msg-bubble__text">"hi "<a class="underline decoration-dotted underline-offset-2 hover:opacity-80" href="https://example.org" rel="noopener noreferrer nofollow" target="_blank">"https://example.org"</a></p><div class="msg-bubble__attach"><a class="msg-bubble__file" download="d.pdf" href="data:application/pdf;base64,AA"><svg aria-hidden="true" class="lucide lucide-paperclip h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"></path></svg>" d.pdf"</a><div class="msg-bubble__meta">"application/pdf · 3 B"</div></div></div></div></article>"`;

exports[`message layouts > in · full 1`] = `"<article class="msg-row flex justify-start" data-sealed="pair" data-testid="message-m1"><div class="msg-bubble msg-bubble--theirs msg-bubble--private vanish-ring" data-private="1" style="color: #f00; --vp: 1;"><button aria-label="Message info" class="msg-info-btn" data-testid="msg-info-m1" title="Message info" type="button"><svg aria-hidden="true" class="lucide lucide-info h-3.5 w-3.5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button><div class="msg-bubble__head"><b>"badge"</b><span class="msg-bubble__time">"10:42"</span><svg aria-label="Encrypted" class="lucide lucide-lock h-3 w-3 opacity-70" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg><svg aria-label="Disappearing" class="lucide lucide-eye-off h-3 w-3 opacity-70" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></div><div class="msg-fwd"><svg aria-hidden="true" class="lucide lucide-forward h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m15 17 5-5-5-5"></path><path d="M4 18v-2a4 4 0 0 1 4-4h12"></path></svg>" Forwarded from: Bob"</div><button class="msg-quote" data-testid="msg-quote-m1" type="button"><svg aria-hidden="true" class="lucide lucide-corner-up-left h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path><path d="M9 14 4 9l5-5"></path></svg><span class="msg-quote__inner"><span class="msg-quote__name">"Bob"</span><span class="msg-quote__text">"t"</span></span></button><div class="msg-bubble__private-tag"><svg aria-hidden="true" class="lucide lucide-lock h-3 w-3" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>" Private: Bob"</div><div><p class="msg-bubble__text">"hi "<a class="underline decoration-dotted underline-offset-2 hover:opacity-80" href="https://example.org" rel="noopener noreferrer nofollow" target="_blank">"https://example.org"</a></p></div><div class="msg-actions"><button class="msg-act" data-testid="msg-reply-m1" type="button"><svg aria-hidden="true" class="lucide lucide-reply h-3.5 w-3.5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path><path d="m9 17-5-5 5-5"></path></svg>" Reply"</button><button class="msg-act" data-testid="msg-forward-m1" type="button"><svg aria-hidden="true" class="lucide lucide-forward h-3.5 w-3.5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m15 17 5-5-5-5"></path><path d="M4 18v-2a4 4 0 0 1 4-4h12"></path></svg>" Forward"</button></div></div></article>"`;

