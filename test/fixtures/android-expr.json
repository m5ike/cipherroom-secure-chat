{
  "scope": {
    "app": { "name": "M5cet", "version": "6.0.0" },
    "room": { "name": "team", "users": 4, "unread": 0, "active": true, "key": "team" },
    "rooms": [
      { "name": "team", "unread": 0 },
      { "name": "family", "unread": 7 }
    ],
    "msg": { "text": "Ahoj světe, jak se máš dnes?", "sender": "Alice", "replyTo": null, "size": 1536000 },
    "count": 3,
    "zero": 0,
    "empty": "",
    "flag": false,
    "ratio": 0.25,
    "list": [],
    "form": { "name": "Mike" }
  },
  "strings": { "users.me": "já", "rooms.connected": "Připojeno", "rooms.saved": "Uložená" },
  "expressions": [
    { "src": "1 + 2 * 3", "value": 7 },
    { "src": "(1 + 2) * 3", "value": 9 },
    { "src": "10 / 4", "value": 2.5 },
    { "src": "10 % 4", "value": 2 },
    { "src": "1 / 0", "value": null },
    { "src": "-$count + 1", "value": -2 },
    { "src": "$room.users > 3", "value": true },
    { "src": "$room.users >= 5", "value": false },
    { "src": "$room.name == 'team'", "value": true },
    { "src": "$room.name === \"team\"", "value": true },
    { "src": "$room.name != 'team'", "value": false },
    { "src": "$count == '3'", "value": false },
    { "src": "$rooms.length", "value": 2 },
    { "src": "$rooms[1].unread", "value": 7 },
    { "src": "$rooms[5].unread", "value": null },
    { "src": "$msg.replyTo.sender", "value": null },
    { "src": "$missing.deep.value", "value": null },
    { "src": "$msg.text.length", "value": 28 },
    { "src": "$room.active ? 'on' : 'off'", "value": "on" },
    { "src": "$flag ? 'on' : 'off'", "value": "off" },
    { "src": "$zero || 'fallback'", "value": "fallback" },
    { "src": "$empty || $room.name", "value": "team" },
    { "src": "$count && 'yes'", "value": "yes" },
    { "src": "$zero && 'yes'", "value": 0 },
    { "src": "!$list", "value": false },
    { "src": "!$empty", "value": true },
    { "src": "!!$room", "value": true },
    { "src": "'a' + 1", "value": "a1" },
    { "src": "1 + '2'", "value": "12" },
    { "src": "'b' > 'a'", "value": true },
    { "src": "$ratio * 4", "value": 1 },
    { "src": "_('users.me')", "value": "já" },
    { "src": "_('unknown.key')", "value": "unknown.key" },
    { "src": "$room.connected ? 1 : $room.users - 1", "value": 3 },
    { "src": "true && false || true", "value": true },
    { "src": "null == $missing", "value": true }
  ],
  "templates": [
    { "src": "Hello {$form.name}!", "text": "Hello Mike!" },
    { "src": "{$room.users} people", "text": "4 people" },
    { "src": "{$msg.text|truncate:10}", "text": "Ahoj svět…" },
    { "src": "{$msg.sender|upper} / {$msg.sender|lower}", "text": "ALICE / alice" },
    { "src": "{$missing|default:'—'}", "text": "—" },
    { "src": "{$rooms|count} rooms", "text": "2 rooms" },
    { "src": "{$msg.size|size}", "text": "1.5 MB" },
    { "src": "{$count|size}", "text": "3 B" },
    { "src": "{_'users.me'}", "text": "já" },
    { "src": "{=$room.users * 2} seats", "text": "8 seats" },
    { "src": "{=$room.active ? _('rooms.connected') : _('rooms.saved')}", "text": "Připojeno" },
    { "src": "{{literal} {$room.name}", "text": "{literal} team" },
    { "src": "{$ratio}", "text": "0.25" },
    { "src": "{$flag}", "text": "false" },
    { "src": "{$missing}", "text": "" },
    { "src": "{$rooms.1.name}", "text": "family" },
    { "src": "No placeholders", "text": "No placeholders" }
  ],
  "invalid": {
    "expressions": ["1 +", "$", "foo", "(1 + 2", "'open", "1 ? 2", "$a..b", "_(x)", "a = 1"],
    "templates": ["{unclosed", "{foo}", "{$x|nosuchfilter}", "{=1 +}"]
  }
}
