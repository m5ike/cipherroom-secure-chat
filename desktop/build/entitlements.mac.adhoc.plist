<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M5cet Desktop — entitlements of an UNSIGNED local build (ad-hoc signature, "-").
  The release set plus disable-library-validation: an ad-hoc signature has no team,
  so the hardened runtime would refuse to load the (ad-hoc signed) Electron framework.
  Never used for a Developer ID build.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
