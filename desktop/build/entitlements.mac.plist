<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M5cet Desktop — hardened runtime entitlements of a release (Developer ID) build.
  Only what the web client needs:
    allow-jit                 V8 compiles JavaScript and WebAssembly (MAP_JIT); Electron cannot run without it
    device.camera / audio-input   calls, dictation (the macOS privacy prompt still asks)
    personal-information.location sharing a position, when the user chooses to
    network.client            the server, WebRTC (documents the intent; required only in a sandbox)
  Not granted: unsigned executable memory, library validation off (a release loads
  only frameworks signed by the same team), DYLD environment variables, debugging.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
