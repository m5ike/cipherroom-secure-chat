# CipherRoom — production-safe defaults (all vars optional)

# ───────────────────────────── Signaling ─────────────────────────────
# Externí WS URL pro statický frontend (Netlify/Vercel)
# VITE_SIGNALING_URL=

# ───────────────────────────── TURN server ─────────────────────────
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=replace-me
# VITE_TURN_CREDENTIAL=replace-me

# ─────────────────────────── File attachment ────────────────────────
# Maximální velikost jedné přílohy v bajtech (default 2 GB)
# VITE_MAX_ATTACHMENT_BYTES=2147483648

# ───────────────────────────── Server limits ────────────────────────
# MAX_PEERS_PER_ROOM=16
# FRAME_BUDGET_PER_SEC=20
# FRAME_BURST=80
# WS_HEARTBEAT_MS=25000
# MAX_FRAME_BYTES=131072

# ─────────────────────────── Event logging ─────────────────────────
# LOG_EVENTS=1
# DATABASE_URL=sqlite:./data/events.db

# ───────────────────────────── VAPID push ──────────────────────────
# Generujte klíče: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
