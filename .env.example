# M5cet environment configuration
# Copy this file to .env and fill in the values you need.
# The app runs without any of these variables in Light / P2P mode.

# Main app port (default 5000)
PORT=5000

# Node environment (development | production)
NODE_ENV=production

# Optional: external WebSocket signaling URL for the client build
# VITE_SIGNALING_URL=wss://chat.example.com/ws

# Admin API (separate service). Set ENABLE_ADMIN=1 and a strong token to enable.
ENABLE_ADMIN=0
ADMIN_PORT=5050
ADMIN_BIND=127.0.0.1
ADMIN_API_TOKEN=change-me-to-a-random-token-at-least-32-bytes-long

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Optional server-enhanced metadata logging.
# LOG_EVENTS=1 enables event logging.
# DATABASE_URL can point to SQLite or PostgreSQL for persistent metadata.
# NOTE: the database backend is currently a stub; only in-memory logging is implemented.
LOG_EVENTS=0
DATABASE_URL=

# Optional TURN server for restrictive NAT/firewall environments.
# TURN is disabled if TURN_SERVER_URL is empty.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
