{
  "name": "cipherroom-secure-chat",
  "version": "6.13.0",
  "description": "M5cet — end-to-end encrypted WebRTC P2P workspace (chat, calls, files, speech, NFC, maps, push) with WebSocket signaling and no message persistence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "./node_modules/.bin/tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "admin": "NODE_ENV=production node dist/admin.cjs",
    "admin:dev": "ENABLE_ADMIN=1 tsx server/admin.ts",
    "health": "node -e \"fetch('http://127.0.0.1:' + (process.env.PORT || 5000) + '/api/health').then(r=>{if(!r.ok)process.exit(1);return r.json()}).then(j=>console.log(JSON.stringify(j)))\"",
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "load-test": "node scripts/load-test.mjs",
    "check:menu": "bash scripts/pre-commit-check.sh",
    "docs:pdf": "node scripts/docs-pdf.mjs",
    "gen:builtins": "node script/gen-builtins.mjs",
    "check:menu:verbose": "bash -x scripts/pre-commit-check.sh",
    "android:assets": "tsx script/android-assets.ts",
    "android:build": "node script/android-build.mjs",
    "android:release": "node script/android-build.mjs --release",
    "release:manifest": "tsx script/release-manifest.ts manifest",
    "release:web-manifest": "tsx script/release-manifest.ts web-manifest",
    "release:keygen": "tsx script/release-manifest.ts keygen",
    "release:sign": "tsx script/release-manifest.ts sign",
    "release:verify": "tsx script/release-manifest.ts verify",
    "docs:summary-pdf": "node scripts/security-summary-pdf.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "@noble/post-quantum": "^0.7.1",
    "bwip-js": "^4.11.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.47.0",
    "openpgp": "^6.3.2",
    "pyodide": "^314.0.7",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sshpk": "^1.18.0",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sshpk": "^1.17.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "bufferutil": "^4.0.8",
    "sherpa-onnx-node": "^1.13.8"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
