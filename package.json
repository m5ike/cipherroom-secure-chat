{
  "name": "cipherroom-secure-chat",
  "version": "2.2.0",
  "description": "M5cet — end-to-end encrypted WebRTC P2P workspace (chat, calls, files, speech, NFC, maps, push) with WebSocket signaling and no message persistence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "./node_modules/.bin/tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "admin": "NODE_ENV=production node dist/admin.cjs",
    "admin:dev": "ENABLE_ADMIN=1 tsx server/admin.ts",
    "health": "node -e \"fetch('http://127.0.0.1:' + (process.env.PORT || 5000) + '/api/health').then(r=>{if(!r.ok)process.exit(1);return r.json()}).then(j=>console.log(JSON.stringify(j)))\"",
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:menu": "bash scripts/pre-commit-check.sh",
    "check:menu:verbose": "bash -x scripts/pre-commit-check.sh"
  },
