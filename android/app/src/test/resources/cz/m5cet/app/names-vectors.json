{
  "version": 1,
  "about": "6.12 (security analysis F-22): display names. The Android app (core/Names.java, NamesTest) and the web (client/src/lib/names.ts) must give these answers.",
  "rules": {
    "normalize": "strip every \\p{Cc} and \\p{Cf} character (line break, CR and tab become a space first), NFKC, strip \\p{Cc}/\\p{Cf} again, every run of white space (incl. no-break and ideographic spaces) -> one space, trim, at most 48 code points (never a split surrogate pair), trim again",
    "skeleton": "normalize, NFD, drop \\p{Mn}, map the look-alikes (table), lower case (locale-independent), map the look-alikes again",
    "lookalikes": {
      "Cyrillic capitals": "\u0410\u0412\u0415\u041a\u041c\u041d\u041e\u0420\u0421\u0422\u0425\u0423\u0405\u0406\u0408\u051a\u051c\u04ae -> ABEKMHOPCTXYSIJQWY",
      "Cyrillic small": "\u0430\u0435\u043e\u0440\u0441\u0443\u0445\u0455\u0456\u0458\u051b\u051d\u04bb\u04af\u04cf\u043a -> aeopcyxsijqwhylk",
      "Greek capitals": "\u0391\u0392\u0395\u0396\u0397\u0399\u039a\u039c\u039d\u039f\u03a1\u03a4\u03a5\u03a7 -> ABEZHIKMNOPTYX",
      "Greek small": "\u03bf\u03bd\u03b1\u03b9\u03ba\u03c1\u03c5\u03c7\u03b3 -> ovaikpuxy",
      "Latin": "\u0131 0 1 -> i o l"
    },
    "mixedScript": "a word (split at the single spaces of the normalized name) with letters of two or three of Latin, Cyrillic, Greek",
    "confusable": "two names whose normalized forms differ but whose skeletons are equal",
    "flags": "among people shown together ({identity, name}): a mixed-script name, or a skeleton that another identity has too",
    "shown": "a flagged name is shown as \"\u26a0 \" + its normalized form"
  },
