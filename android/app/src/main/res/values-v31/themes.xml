<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.M5" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/m5_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/m5_brand</item>
        <item name="android:colorPrimary">@color/m5_brand</item>
        <!-- The system splash: the animated mark, then the design's own splash takes over. -->
        <item name="android:windowSplashScreenBackground">@color/m5_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">800</item>
    </style>
</resources>
