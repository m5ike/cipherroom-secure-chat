<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- 6.8: a self-managed calling account, only so that the phone's call log names the app of its
         entries (telecom/CallLogBridge); no call ever goes through Telecom. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 6.1: a position in messages and (opt-in) tracking; NFC tools. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- 6.2 people: linking people with the phone's contacts (asked for when the user links one). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <!-- 6.3 nfc: an optional USB-host PC/SC (CCID) reader (e.g. ACR122U / ACR1252U over OTG).
         Permission for a specific device is asked at runtime (UsbManager); no extra <uses-permission>. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!-- 6.7 location: the navigation and ride apps a position can open (location/GeoLinks.java
         names the same packages) and every app that opens geo: — visible to the picker on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="cz.seznam.mapy" />
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand" />
        <package android:name="com.sygic.aura" />
        <package android:name="com.here.app.maps" />
        <package android:name="com.ubercab" />
        <package android:name="ee.mtakso.client" />
        <package android:name="com.adleritech.app.liftago.passenger" />
        <package android:name="taxi.android.client" />
    </queries>

    <application
        android:name=".M5"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.M5"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- m5cet://enroll?server=…&code=…&kid=… (the console's QR code) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="m5cet" android:host="enroll" />
            </intent-filter>
            <!-- Text shared from another app goes to the room on screen (6.8: or, shared straight into a
                 room's conversation — res/xml/shortcuts.xml — to that room), into its message field. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 6.8 conversations: the rooms' conversation shortcuts as direct share targets (telecom/Conversations). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- 6.2 people: "Zpráva přes M5cet" / "Volat přes M5cet" tapped on a linked contact in the
                 Contacts app (contacts.ContactIntents; the MIME types of res/xml/contacts.xml). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.cz.m5cet.message" />
                <data android:mimeType="vnd.android.cursor.item/vnd.cz.m5cet.call" />
            </intent-filter>
        </activity>

        <!-- ================= 6.2 people: links between M5cet people and the phone's contacts =================
             An account type of the app's own (no password, never synced) whose raw contacts carry the
             M5cet rows, kept together with the contacts the user chose (contacts.AddressBook). -->
        <service
            android:name=".contacts.AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/authenticator" />
        </service>
        <!-- The contacts "sync adapter": it never syncs; the Contacts app reads the rows' kinds from its meta-data. -->
        <service
            android:name=".contacts.SyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data android:name="android.content.SyncAdapter" android:resource="@xml/syncadapter" />
            <meta-data android:name="android.provider.CONTACTS_STRUCTURE" android:resource="@xml/contacts" />
        </service>
        <!-- "Propojit s kontaktem": opens the contact picker and links the chosen contact (no UI of its own). -->
        <activity
            android:name=".contacts.LinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- ================================================================================================= -->

        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".push.Checkin$Job"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".ui.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
        <!-- 6.1: files of messages for other apps (decrypted as read) and the camera's photo. -->
        <provider
            android:name=".ui.media.VaultMedia$FilesProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service
            android:name=".nfc.CardService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data android:name="android.nfc.cardemulation.host_apdu_service" android:resource="@xml/apduservice" />
        </service>
        <service
            android:name=".location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver android:name=".update.InstallReceiver" android:exported="false" />
        <receiver android:name=".telecom.ReplyReceiver" android:exported="false" />
        <!-- 6.8 conversations: the lock check of a frozen or ended process (shortcut names go neutral). -->
        <receiver android:name=".telecom.Conversations$Alarm" android:exported="false" />
        <!-- 6.8: Decline on a call's ring (telecom/CallRing). -->
        <receiver android:name=".telecom.CallRing$Receiver" android:exported="false" />
        <!-- 6.8: the service of the calling account the call log entries name; it refuses every
             connection (the rooms' calls are WebRTC, never Telecom's). -->
        <service
            android:name=".telecom.M5ConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- One APK for any server: Firebase starts with the server's settings, not a google-services.json. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
    </application>
</manifest>
