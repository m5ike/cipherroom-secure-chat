.git
node_modules
dist
*.log
qa-*.png
tool_calls
.DS_Store

# Secrets must never enter a build layer (ADMIN_API_TOKEN, VAPID private key,
# TURN credentials). Runtime config comes from the container environment.
# 6.7 (F-27): every .env* — a hand-made .env-bak too (the build stage's
# COPY . . would put it into the build cache).
.env*
*.bak
!.env.example
# 6.12: no private key of any kind in the build context (release signing,
# TLS, provider keys, Android keystores).
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Not needed to build the image.
.claude
.memory
.github
.githooks
docs
test
browser-only-firebase
*.md

# Installer state and generated files never belong in an image.
.m5cet
installer
install.sh
update.sh
uninstall.sh
check.sh
release.json
release.json.sig
