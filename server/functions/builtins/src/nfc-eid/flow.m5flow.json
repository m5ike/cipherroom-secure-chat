{
  "format": "m5flow",
  "version": 1,
  "lang": "js",
  "name": "Read an e-ID / e-passport",
  "summary": "Every data group of your ID card or passport, with the photo",
  "nodes": [
    {
      "id": "n1",
      "type": "out.form",
      "x": 80,
      "y": 120,
      "params": {
        "form": {
          "name": "nfc-eid",
          "title": "Read an e-ID / e-passport",
          "text": "Your own document: the CAN opens an ID card (PACE), the MRZ a passport (BAC). Then hold it to your phone or reader.",
          "submit": "Read",
          "labels": "top",
          "fields": [
            {
              "name": "can",
              "type": "text",
              "label": "CAN — the 6 digits printed on the card",
              "pattern": "^[0-9]{6}$",
              "placeholder": "123456",
              "help": "On an EU ID card: the 6-digit number on the front. Passports: leave it empty and give the MRZ or the three fields below."
            },
            {
              "name": "mrz",
              "type": "textarea",
              "label": "or the MRZ (the 2–3 lines at the bottom of the data page)",
              "rows": 3
            },
            {
              "name": "documentNumber",
              "type": "text",
              "label": "or the document number",
              "placeholder": "L898902C"
            },
            {
              "name": "dateOfBirth",
              "type": "text",
              "label": "Date of birth (YYMMDD)",
              "pattern": "^[0-9]{6}$",
              "placeholder": "690806"
            },
            {
              "name": "dateOfExpiry",
              "type": "text",
              "label": "Date of expiry (YYMMDD)",
              "pattern": "^[0-9]{6}$",
              "placeholder": "940623"
            }
          ]
        }
      },
      "values": {}
    }
  ],
