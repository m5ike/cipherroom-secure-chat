        "form": {
          "name": "tel-sms",
          "title": "SMS",
          "text": "Send an SMS",
          "submit": "Send",
          "labels": "top",
          "fields": [
            {
              "name": "to",
              "type": "tel",
              "label": "Recipient",
              "required": true,
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "placeholder": "+420603123456",
              "help": "In the international form: +420603123456"
            },
            {
              "name": "text",
              "type": "textarea",
              "label": "Text",
              "required": true,
              "rows": 4,
              "pattern": "^[\\s\\S]{1,1600}$",
              "help": "Up to 1600 characters (about ten SMS)"
            },
            {
              "name": "from",
              "type": "text",
              "label": "Sender (empty: default)",
              "pattern": "^([+0-9]{3,16}|[A-Za-z0-9 ]{1,11})?$",
              "help": "A number, or up to 11 letters where the country allows it"
            }
          ]
        }
