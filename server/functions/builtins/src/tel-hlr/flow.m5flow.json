        "title": "HLR"
      },
      "values": {}
    },
    {
      "id": "n8",
      "type": "code.block",
      "x": 940,
      "y": 240,
      "params": {
        "args": "number, typed",
        "code": "const t = String(typed || \"\");\nconst form = {\"name\":\"tel-hlr\",\"title\":\"HLR\",\"text\":\"Ask a number's home network: reachable, roaming, ported\",\"submit\":\"Send\",\"labels\":\"top\",\"fields\":[{\"name\":\"number\",\"type\":\"tel\",\"label\":\"Number\",\"required\":true,\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"placeholder\":\"+420603123456\",\"help\":\"In the international form: +420603123456\"}]};\nif (t) await m5.caller.send(m5.out.flash(`“${t}” is not a phone number in the international form (+420603123456).`, \"error\"));\nawait m5.caller.send(m5.out.form(t ? { ...form, text: `“${t}” is not a phone number in the international form — correct it and send.`, fields: form.fields.map((f) => (f.name === \"number\" ? { ...f, default: t } : f)) } : form));\nreturn t;"
      },
      "values": {},
      "label": "The form (prefilled)"
    }
