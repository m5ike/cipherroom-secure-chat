{
  "format": "m5flow",
  "version": 1,
  "lang": "js",
  "name": "HLR",
  "summary": "Ask a number's home network: reachable, roaming, ported",
  "nodes": [
    {
      "id": "n1",
      "type": "flow.input",
      "x": 40,
      "y": 120,
      "params": {
        "name": "number",
        "type": "string",
        "label": "Number",
        "default": "",
        "required": false,
        "values": ""
      },
      "values": {}
    },
    {
      "id": "n2",
      "type": "code.expr",
      "x": 220,
      "y": 120,
      "params": {
        "args": "n",
        "expr": "String(n ?? \"\").trim().slice(0, 40)"
      },
      "values": {},
      "label": "What was typed"
    },
    {
      "id": "n3",
      "type": "code.expr",
      "x": 400,
      "y": 120,
      "params": {
        "args": "t",
        "expr": "t.replace(/[\\s().\\/-]/g, \"\").replace(/^00(?=[1-9])/, \"+\")"
      },
      "values": {},
      "label": "Tidy the number"
    },
    {
      "id": "n4",
      "type": "logic.compare",
      "x": 580,
      "y": 60,
      "params": {
        "op": "matches"
      },
      "values": {
        "b": "^\\+[1-9][0-9]{6,14}$"
      },
      "label": "International form?"
    },
    {
      "id": "n5",
      "type": "logic.if",
      "x": 760,
      "y": 120,
      "params": {},
      "values": {}
    },
